+function run_mutsig_persample(maf, outdir, sample_axis_file)
+% Run the (DIALECT-patched) MutSig2CV v3.11 source on a MAF, dumping the
+% per-(gene,patient,effect) expected background to
+% <outdir>/persample_lambda.f32 plus axis metadata.
+% SAMPLE_AXIS_FILE is required: one unique, lexicographically sorted sample ID
+% per line, including samples with zero retained mutation events.  Uses the
+% reference files vendored with the compiled bundle.
+%
+%   matlab -batch "run_mutsig_persample('/abs/cohort.maf','/abs/outdir','/abs/sample_axis.txt')"
+
+if nargin ~= 3
+  error(['DIALECT requires maf, outdir, and sample_axis_file; refusing the ' ...
+         'legacy mutation-derived patient axis']);
+end
+
+here   = fileparts(mfilename('fullpath'));        % .../external/MutSig2CV_src
+repo   = fileparts(fileparts(here));              % repo root
+refdir = fullfile(repo, 'external', 'MutSig2CV', 'mutsig2cv', 'reference');
+
+addpath(genpath(fullfile(here, 'src')));
+demand_file(sample_axis_file);
+javaaddpath(fullfile(refdir, 'FixedWidthBinary.jar'));
+if exist('OCTAVE_VERSION', 'builtin')
+  pkg load statistics    % binofit, binopdf, hygepdf, ... used throughout MutSig
+end
+
+% the source's reference paths default to 'reference/...', resolved from the
+% compiled bundle dir, so run with that as the working directory.
+oldcd = cd(fullfile(repo, 'external', 'MutSig2CV', 'mutsig2cv'));
+cleanupObj = onCleanup(@() cd(oldcd)); %#ok<NASGU>
+
+if ~exist(outdir, 'dir'), mkdir(outdir); end
+P = [];
+P.sample_axis_file = sample_axis_file;
+MutSig2CV(maf, outdir, P);
+fprintf('DIALECT: wrote %s/persample_lambda.f32\n', outdir);
+end
