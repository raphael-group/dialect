diff --git a/src/dialect_deduplicate_mutations.m b/src/dialect_deduplicate_mutations.m
new file mode 100644
index 0000000..a498491
--- /dev/null
+++ b/src/dialect_deduplicate_mutations.m
@@ -0,0 +1,30 @@
+function [mut, keep_idx] = dialect_deduplicate_mutations(mut)
+% Keep the first row per full somatic-allele key.
+%
+% Coordinate-only deduplication erases valid multiallelic calls.  At this point
+% NEWBASE is MutSig's effective alternate allele (allele 2 when allele 1 equals
+% the reference), so it belongs in the identity key with the reference allele.
+% Canonical DIALECT alleles are stripped and uppercased before comparison.
+
+demand_fields(mut, {'patient','chr','pos','ref_allele','newbase'});
+mut.ref_allele = normalize_alleles(mut.ref_allele, 'reference');
+mut.newbase = normalize_alleles(mut.newbase, 'alternate');
+[~, keep_idx] = unique_combos( ...
+    mut.patient, mut.chr, mut.pos, mut.ref_allele, mut.newbase, 'first');
+mut = reorder_struct(mut, keep_idx);
+end
+
+function alleles = normalize_alleles(alleles, label)
+if ~iscell(alleles)
+  error('DIALECT %s alleles must be a cell array of strings', label);
+end
+for ii = 1:numel(alleles)
+  if ~ischar(alleles{ii})
+    error('DIALECT %s allele %d is not a string', label, ii);
+  end
+  alleles{ii} = upper(strtrim(alleles{ii}));
+  if isempty(alleles{ii}) || any(isspace(alleles{ii}))
+    error('DIALECT %s allele %d is empty or contains whitespace', label, ii);
+  end
+end
+end
diff --git a/src/dialect_load_sample_axis.m b/src/dialect_load_sample_axis.m
new file mode 100644
index 0000000..fc0c28f
--- /dev/null
+++ b/src/dialect_load_sample_axis.m
@@ -0,0 +1,23 @@
+function sample_axis = dialect_load_sample_axis(sample_axis_file)
+% Load DIALECT's exact ordered sample universe and fail closed on ambiguity.
+
+demand_file(sample_axis_file);
+sample_axis = load_lines(sample_axis_file);
+sample_axis = as_column(regexprep(sample_axis, '\r$', ''));
+
+if isempty(sample_axis)
+  error('DIALECT sample axis is empty: %s', sample_axis_file);
+end
+if any(cellfun('isempty', sample_axis))
+  error('DIALECT sample axis contains an empty sample ID');
+end
+if ~isequal(sample_axis, strtrim(sample_axis))
+  error('DIALECT sample axis IDs must not have leading or trailing whitespace');
+end
+if numel(unique(sample_axis)) ~= numel(sample_axis)
+  error('DIALECT sample axis IDs must be unique');
+end
+if ~isequal(sample_axis, sort(sample_axis))
+  error('DIALECT sample axis IDs must be lexicographically ordered');
+end
+end
diff --git a/src/dialect_validate_persample_lambda.m b/src/dialect_validate_persample_lambda.m
new file mode 100644
index 0000000..9ef934f
--- /dev/null
+++ b/src/dialect_validate_persample_lambda.m
@@ -0,0 +1,11 @@
+function dialect_validate_persample_lambda(lambda, written)
+% Fail closed unless every gene/effect slice has a finite, nonnegative value.
+
+expected_written_size = [size(lambda,1), size(lambda,3)];
+if ~isequal(size(written), expected_written_size) || ~all(written(:))
+  error('DIALECT did not compute every per-gene/effect lambda slice');
+end
+if any(~isfinite(lambda(:))) || any(lambda(:) < 0)
+  error('DIALECT per-sample lambda tensor contains invalid values');
+end
+end
